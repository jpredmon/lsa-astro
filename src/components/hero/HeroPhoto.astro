---
import { getImage } from 'astro:assets';

import heroDesktopSrc from '../../assets/hero/hero-desktop.jpeg';
import heroMobileSrc from '../../assets/hero/hero-mobile.jpeg';

const CREDIT_URL = 'https://www.instagram.com/ldcha.residentservices';

const heroDesktop = await getImage({
  src: heroDesktopSrc,
  width: 1024,
  height: 768,
  format: 'webp',
});
const heroMobile = await getImage({ src: heroMobileSrc, width: 480, height: 360, format: 'webp' });
---

<figure class="hero-photo">
  <picture>
    <source media="(max-width: 767px)" srcset={heroMobile.src} width="480" height="360" />
    <img
      src={heroDesktop.src}
      width="1024"
      height="768"
      alt="Skaters at the 2024 Build-a-Board event"
      loading="eager"
      class="hero-photo__image"
    />
  </picture>
  <figcaption class="hero-photo__caption">
    <a href={CREDIT_URL} target="_blank" rel="noopener" class="hero-photo__credit-link"
      ><strong>Build-a-Board 2024</strong></a
    > - Photo: Nicholas Ward
  </figcaption>
</figure>

<style>
  .hero-photo {
    margin: 0;
  }

  .hero-photo__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Static in-flow caption, NOT an absolute overlay — corrects the
     migration spec's original "caption overlay" wording; live-verified
     position: static directly below the image. */
  .hero-photo__caption {
    margin: var(--space-xs) 0 0;
    /* PREVIEW: bumped from --font-size-caption (12.8px) to 19px — WCAG's
       "large text" threshold for bold text is 14pt (~18.7px). At this size,
       the credit-link color below only needs a 3:1 contrast ratio instead
       of 4.5:1. Scoped to this caption only, not applied to the shared
       token or ParkPhoto yet. */
    font-size: 19px;
    color: var(--color-ink);
    background-color: transparent;
    text-align: center;
  }

  .hero-photo__credit-link {
    text-decoration: none;
  }

  .hero-photo__credit-link strong {
    /* PREVIEW: logo's exact red (sampled from logo-master.png), replacing
       --color-highlight-yellow (1.38:1 on cream, failed WCAG). At this
       caption's 19px bold size, red-on-cream measures 3.57:1, clearing
       the 3:1 large-text threshold. */
    color: #f23457;
  }
</style>
