---
interface Props {
  plainText: string;
  highlightedText: string;
  as?: 'h2' | 'h3' | 'h4';
  pulseDurationMs?: number;
  drawDurationMs?: number;
}

const {
  plainText,
  highlightedText,
  as: Tag = 'h3',
  pulseDurationMs = 1250,
  drawDurationMs = 1200,
}: Props = Astro.props;
---

<Tag class="headline" style={`animation-duration: ${pulseDurationMs}ms`}>
  {plainText}{' '}
  <span class="headline__highlight-wrap">
    <span class="headline__highlight">{highlightedText}</span>
    <svg
      class="headline__underline"
      viewBox="0 0 500 150"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
      data-draw-duration-ms={drawDurationMs}
    >
      <path d="M7.7,145.6C109,125,299.9,116.2,401,121.3c42.1,2.2,87.6,11.8,87.3,25.7"></path>
    </svg>
  </span>
</Tag>

<style>
  /* No define:vars anywhere in this file: it injects custom properties via
     an inline style="" HTML attribute, and our CSP (no 'unsafe-inline' in
     style-src) blocks inline style attributes just like it blocks inline
     <style> tags — confirmed live: this silently broke the underline loop
     (var(--cycleDuration) never resolved, invalidating the whole animation
     shorthand). All timing/size values are hardcoded literals instead.

     animation-duration for the pulse is set via a literal inline style prop
     on the Tag element (a plain string, not define:vars) — Astro's
     define:vars only injects onto elements it can statically identify as
     plain HTML tags, and Tag here is a dynamic/capitalized reference
     (h2/h3/h4 chosen at runtime), so define:vars silently skips it anyway,
     on top of the CSP issue above. A var() that fails to resolve invalidates
     the WHOLE animation shorthand, not just the duration, so this rule must
     stay free of any var() — the shorthand below only sets
     name/timing/iteration-count, and the inline style overrides just the
     duration longhand.

     Font size is hardcoded here for the same reason (Tag can't receive
     define:vars custom properties at all, at any breakpoint) — these are
     Hero's own live-measured values (120px/64px/45px, NOT the generic h3
     token scale; this widget has its own dedicated typography on the live
     site, unrelated to h1-h6). Only Hero uses this component right now; if
     a later phase needs a different size, that's when a size-variant class
     gets added — no point generalizing for a need that doesn't exist yet. */
  .headline {
    font-size: 120px;
    line-height: 0.9em;
    font-weight: var(--font-weight-bold);
    text-align: left;
    animation: headline-pulse 1s ease 1;
  }

  @media (max-width: 1024px) {
    .headline {
      font-size: 64px;
    }
  }

  @media (max-width: 767px) {
    .headline {
      font-size: 45px;
    }
  }

  @keyframes headline-pulse {
    from {
      transform: scale3d(1, 1, 1);
    }
    50% {
      transform: scale3d(1.05, 1.05, 1.05);
    }
    to {
      transform: scale3d(1, 1, 1);
    }
  }

  .headline__highlight-wrap {
    position: relative;
    display: inline-block;
  }

  .headline__highlight {
    position: relative;
    z-index: 1;
  }

  /* overflow: visible — the path's y-values (up to ~146) plus half the 20px
     stroke-width exceed the 150-tall viewBox; without this the stroke's
     bottom edge clips.

     width/height: 100% (not just inset: 0) — SVG is a replaced element with
     an intrinsic aspect ratio from its viewBox (500:150); confirmed live
     that inset: 0 alone does NOT override that ratio on an absolutely
     positioned SVG, so it rendered taller than its container instead of
     filling it exactly. Explicit 100%/100% forces a true fill regardless of
     the viewBox ratio, letting preserveAspectRatio="none" do the stretching. */
  .headline__underline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }

  .headline__underline path {
    fill: none;
    stroke: var(--color-highlight-yellow);
    stroke-width: 20px;
    animation: headline-underline-loop 5s ease infinite;
  }

  /* Combines the live site's two separately-JS-toggled keyframes
     (elementor-headline-dash + hide-highlight) into one self-contained loop,
     timed at Hero's live ratio: draw 0-1200ms (0-24%), hold 1200-4600ms
     (24-92%), fade+blur out 4600-5000ms (92-100%), instant reset into the
     next iteration at 0%. */
  @keyframes headline-underline-loop {
    0% {
      stroke-dasharray: 0, 1500;
      opacity: 1;
      filter: blur(0);
    }
    24% {
      stroke-dasharray: 1500, 1500;
      opacity: 1;
      filter: blur(0);
    }
    92% {
      stroke-dasharray: 1500, 1500;
      opacity: 1;
      filter: blur(0);
    }
    100% {
      stroke-dasharray: 1500, 1500;
      opacity: 0;
      filter: blur(10px);
    }
  }
</style>
