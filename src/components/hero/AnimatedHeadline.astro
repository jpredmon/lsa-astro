---
interface Props {
  plainText?: string;
  highlightedText: string;
  as?: 'h2' | 'h3' | 'h4';
  pulseDurationMs?: number;
  drawDurationMs?: number;
  /* Only two values exist anywhere on the live site — confirmed by polling
     every elementor-headline--style-highlight instance (Hero, About us,
     What we do, Why we do it, Our parks, Who we are): Hero alone uses
     5000ms, every other instance uses 8000ms. Draw (1200ms) and fade
     (400ms) are constant in both cases — only the cycle length (hold
     duration) differs, which is why this can't just be "reuse Hero's
     keyframe percentages with a different animation-duration": the
     percentages themselves are relative to cycle length and would draw
     too fast / hold too long if reused as-is. Restricted to a union
     (not a general number) so a typo'd value fails at compile time
     instead of silently animating with no matching keyframes. */
  cycleDurationMs?: 5000 | 8000;
  variant?: 'hero' | 'section';
}

const {
  plainText = '',
  highlightedText,
  as: Tag = 'h3',
  pulseDurationMs = 1250,
  drawDurationMs = 1200,
  cycleDurationMs = 5000,
  variant = 'hero',
}: Props = Astro.props;
---

<Tag class={`headline headline--${variant}`} style={`animation-duration: ${pulseDurationMs}ms`}>
  {plainText && `${plainText} `}
  <span class="headline__highlight-wrap">
    <span class="headline__highlight">{highlightedText}</span>
    <svg
      class={`headline__underline headline__underline--cycle-${cycleDurationMs}`}
      viewBox="0 0 500 150"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
      data-draw-duration-ms={drawDurationMs}
    >
      <path d="M7.7,145.6C109,125,299.9,116.2,401,121.3c42.1,2.2,87.6,11.8,87.3,25.7"></path>
    </svg>
  </span>
</Tag>

<style>
  /* No define:vars anywhere in this file: it injects custom properties via
     an inline style="" HTML attribute, and our CSP (no 'unsafe-inline' in
     style-src) blocks inline style attributes just like it blocks inline
     <style> tags — confirmed live: this silently broke the underline loop
     (var(--cycleDuration) never resolved, invalidating the whole animation
     shorthand). All timing/size values are hardcoded literals instead.

     animation-duration for the pulse is set via a literal inline style prop
     on the Tag element (a plain string, not define:vars) — Astro's
     define:vars only injects onto elements it can statically identify as
     plain HTML tags, and Tag here is a dynamic/capitalized reference
     (h2/h3/h4 chosen at runtime), so define:vars silently skips it anyway,
     on top of the CSP issue above. A var() that fails to resolve invalidates
     the WHOLE animation shorthand, not just the duration, so this rule must
     stay free of any var() — the shorthand below only sets
     name/timing/iteration-count, and the inline style overrides just the
     duration longhand.

     Font size is hardcoded here for the same reason (Tag can't receive
     define:vars custom properties at all, at any breakpoint). Two variants
     exist: `hero` hardcodes Hero's own live-measured values (120px/64px/
     45px, NOT the generic h3 token scale — this widget has its own
     dedicated typography on the live site, unrelated to h1-h6). `section`
     (About Us: About us / What we do / Why we do it, all rendered with
     as="h2") sets no font-size of its own and instead inherits the
     project's generic h2 CSS tokens from base.css — live-measured values
     for those headings matched the generic h2 scale exactly, so there was
     nothing size-specific to hardcode for this variant. */
  .headline {
    font-weight: var(--font-weight-bold);
    animation: headline-pulse 1s ease 1;
  }

  .headline--hero {
    font-size: 120px;
    line-height: 0.9em;
    text-align: left;
  }

  .headline--section {
    text-align: center;
  }

  @media (max-width: 1024px) {
    .headline--hero {
      font-size: 64px;
    }
  }

  @media (max-width: 767px) {
    .headline--hero {
      font-size: 45px;
    }
  }

  @keyframes headline-pulse {
    from {
      transform: scale3d(1, 1, 1);
    }
    50% {
      transform: scale3d(1.05, 1.05, 1.05);
    }
    to {
      transform: scale3d(1, 1, 1);
    }
  }

  .headline__highlight-wrap {
    position: relative;
    display: inline-block;
  }

  .headline__highlight {
    position: relative;
    z-index: 1;
  }

  /* Underline paints ON TOP of the letters (not behind) — confirmed on the
     live site, where the stroke overlaps the bottom of the glyphs rather
     than sitting fully clear beneath them. */

  /* overflow: visible — the path's y-values (up to ~146) plus half the 20px
     stroke-width exceed the 150-tall viewBox; without this the stroke's
     bottom edge clips.

     Sizing/position confirmed live via getComputedStyle, not a fill: the
     underline SVG is NOT sized to exactly match the highlight-wrap box.
     It's centered on it and oversized by 20px on each axis (live-measured:
     wrap 334.8x57.6px, svg 354.8x77.6px). An exact top-left fill (inset:0;
     100%/100%, tried first) sits the stroke higher relative to the glyphs
     and lets it cut into the letter body instead of clearing it. */
  .headline__underline {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(100% + 20px);
    height: calc(100% + 20px);
    transform: translate(-50%, -50%);
    z-index: 2;
    overflow: visible;
    pointer-events: none;
  }

  .headline__underline path {
    fill: none;
    stroke: var(--color-highlight-yellow);
    stroke-width: 20px;
    animation: headline-underline-loop-5000 5s ease infinite;
  }

  .headline__underline--cycle-8000 path {
    animation-name: headline-underline-loop-8000;
    animation-duration: 8s;
  }

  /* Combines the live site's two separately-JS-toggled keyframes
     (elementor-headline-dash + hide-highlight) into one self-contained loop.
     Two variants because draw (1200ms) and fade (400ms) are constant in
     absolute time but the site uses two different cycle lengths (see the
     cycleDurationMs prop comment) — the percentages below are each
     variant's draw/fade window expressed as a fraction of ITS OWN cycle,
     live-polled per variant rather than assumed from the other's ratio. */
  @keyframes headline-underline-loop-5000 {
    0% {
      stroke-dasharray: 0, 1500;
      opacity: 1;
      filter: blur(0);
    }
    24% {
      stroke-dasharray: 1500, 1500;
      opacity: 1;
      filter: blur(0);
    }
    92% {
      stroke-dasharray: 1500, 1500;
      opacity: 1;
      filter: blur(0);
    }
    100% {
      stroke-dasharray: 1500, 1500;
      opacity: 0;
      filter: blur(10px);
    }
  }

  /* draw 0-1200ms (0-15%), hold 1200-7600ms (15-95%), fade+blur 7600-8000ms
     (95-100%) — live-polled on the "About us" instance (delayMs: 8000). */
  @keyframes headline-underline-loop-8000 {
    0% {
      stroke-dasharray: 0, 1500;
      opacity: 1;
      filter: blur(0);
    }
    15% {
      stroke-dasharray: 1500, 1500;
      opacity: 1;
      filter: blur(0);
    }
    95% {
      stroke-dasharray: 1500, 1500;
      opacity: 1;
      filter: blur(0);
    }
    100% {
      stroke-dasharray: 1500, 1500;
      opacity: 0;
      filter: blur(10px);
    }
  }
</style>
