---
import DonateButton from './header/DonateButton.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <section class="site-footer__support-section">
    <div class="site-footer__support-content">
      <h2>Support our work</h2>
      <p>
        All proceeds support improvements for Lawrence skate amenities and make possible our
        annual Build-a-Board program.
      </p>
      <p>
        We’ve partnered with our non-profit friends at <strong
          ><a href="https://www.mokanskates.com/" target="_blank" rel="noopener"
            >MOKAN SKATES</a
          ></strong
        > (<strong><a href="http://www.harrisonstreetdiy.com">Harrison Street DIY</a></strong> originators) to create this tax deductible donation link!
      </p>
      <div class="site-footer__donate-wrapper">
        <DonateButton variant="cta" />
      </div>
      <p>
        Please email <strong
          ><a href="mailto:lawrenceskatersassociation@gmail.com"
            >lawrenceskatersassociation@gmail.com</a
          ></strong
        > for your tax deductible receipt.
      </p>
    </div>
  </section>

  <section class="site-footer__social-section">
    <a
      href="https://www.instagram.com/lawrence.skaters/"
      target="_blank"
      class="site-footer__social-icon"
      aria-label="Instagram"
    >
      <svg viewBox="0 0 448 512" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path
          d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 275.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"
        ></path>
      </svg>
    </a>
    <a
      href="https://www.facebook.com/SKATELSA"
      target="_blank"
      class="site-footer__social-icon"
      aria-label="Facebook"
    >
      <svg viewBox="0 0 320 512" width="22" height="22" fill="currentColor" aria-hidden="true">
        <path
          d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"
        ></path>
      </svg>
    </a>
  </section>

  <section class="site-footer__copyright-section">
    <p>© {year} Lawrence Skaters Association</p>
  </section>
</footer>

<style>
  .site-footer__support-section {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 80px var(--space-sm) 0;
    text-align: center;
  }

  .site-footer__support-content {
    max-width: 480px;
    margin: 0 auto;
  }

  .site-footer__support-content h2 {
    margin: 0 0 20px;
  }

  .site-footer__support-content p {
    margin: 0 0 16px;
  }

  .site-footer__donate-wrapper {
    margin: 0 0 20px;
  }

  .site-footer__support-content p:last-child {
    margin-bottom: 0;
  }

  .site-footer__support-content a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__social-section {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
    padding: 0 var(--space-sm) 40px;
  }

  .site-footer__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 51px; /* live-measured, though inconsistently (one query read 61.6px) — confirm exact value during Task 4 QA */
    height: 51px;
    border: 1px solid var(--color-ink); /* live-measured, though inconsistently (one query read 0.8px, another 0px) — confirm exact value during Task 4 QA */
    border-radius: 50%;
    color: var(--color-ink);
  }

  .site-footer__copyright-section {
    padding: 0 var(--space-sm) 40px;
    text-align: center;
    font-size: 12px; /* live-measured; doesn't match --font-size-body (16px) or any h-token, single consumer, kept local */
    color: var(--color-ink);
  }

  .site-footer__copyright-section p {
    margin: 0;
  }
</style>
