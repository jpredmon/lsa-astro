---
const VIDEO_EMBED_URL = 'https://www.youtube-nocookie.com/embed/idV0zTsyBPM';
---

<div class="about-video">
  <iframe
    src={VIDEO_EMBED_URL}
    title="Lawrence Skaters Association"
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<style>
  .about-video {
    max-width: var(--container-max-width);
    aspect-ratio: 16 / 9;
    margin: 0 auto;
  }

  .about-video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
