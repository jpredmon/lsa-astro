---
import AnimatedHeadline from './hero/AnimatedHeadline.astro';
import HeroPhoto from './hero/HeroPhoto.astro';
---

<section class="hero" aria-label="Hero">
  <div class="hero__intro">
    <p class="hero__kicker">Our mission is simple</p>
    <AnimatedHeadline as="h1" plainText="Make Lawrence" highlightedText="Skateable" />
  </div>
  <div class="hero__photo-wrap">
    <HeroPhoto />
  </div>
</section>

<style>
  .hero {
    background-color: var(--color-cream-2);
  }

  .hero__intro {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: var(--space-lg) var(--space-sm) var(--space-md);
    text-align: start;
  }

  .hero__kicker {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-h4);
    line-height: var(--line-height-h4);
    letter-spacing: var(--letter-spacing-h4);
    text-transform: var(--text-transform-h4);
  }

  .hero__photo-wrap {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--space-sm) var(--space-lg);
  }

  @media (max-width: 767px) {
    .hero__photo-wrap {
      /* Reduced from --space-lg (60px) so the gap above "About us" (this
         padding + --space-section-gap's mobile value) roughly matches the
         gap below it (the About Us video's own leading padding), instead
         of sitting lopsided. */
      padding-bottom: 10px;
    }
  }
</style>
